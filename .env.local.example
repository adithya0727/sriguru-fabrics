# ── Supabase ─────────────────────────────────────────────────────────────────
# Settings → Data API → Project URL
# (Or read it off the dashboard address bar: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API Keys → "Publishable key" (sb_publishable_...)
# Formerly called the "anon" key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Settings → API Keys → "Secret key" (sb_secret_...)
# Formerly called the "service_role" key. Bypasses row-level security, so it
# must never be prefixed with NEXT_PUBLIC_ — that would ship it to the browser
# and expose every cost price.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Claude ───────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys. Server-only; spends money per call.
ANTHROPIC_API_KEY=sk-ant-...

# ── Site ─────────────────────────────────────────────────────────────────────
# Optional, and best left out. Shareable links are built from the domain the
# request actually arrived on, so they are right on localhost, through a dev
# tunnel, and in production without any setting at all.
#
# Set it only to force one canonical domain when the site answers on several —
# and remember NEXT_PUBLIC_ values are baked in at build time, so changing it
# needs a fresh deploy.
# NEXT_PUBLIC_SITE_URL=https://www.srigurufabrics.in
